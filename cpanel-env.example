NODE_ENV=production
DB_CLIENT=mysql
MYSQL_HOST=localhost
MYSQL_DATABASE=YOUR_CPANEL_DATABASE
MYSQL_USER=YOUR_CPANEL_DATABASE_USER
MYSQL_PASSWORD=YOUR_CPANEL_DATABASE_PASSWORD
JWT_SECRET=CHANGE_TO_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_TO_LONG_RANDOM_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ALLOWED_ORIGINS=https://YOUR_DOMAIN,http://YOUR_DOMAIN
MAX_FILE_SIZE=10485760
