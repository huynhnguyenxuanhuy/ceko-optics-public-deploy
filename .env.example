# ── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql://ceko_user:your_password@localhost:5432/ceko_optics

# ── SERVER ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=replace_with_random_64_plus_chars_access_secret_before_production_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_random_64_plus_chars_refresh_secret_before_production_2026
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:3000,http://127.0.0.1:4000,null,https://cekooptics.com.vn

# ── UPLOAD ──────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
